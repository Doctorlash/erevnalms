generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  firstName            String
  lastName             String
  email                String    @unique
  password             String
  role                 Role      @default(STUDENT)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  isActive             Boolean   @default(true)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  bio                  String?
  classLevel           String?
  phone                String?
  profileImage         String?
  school               String?
  isOnline             Boolean   @default(false)
  lastSeen             DateTime?

  studentProgrammes          StudentProgramme[]
  subjectRequests            SubjectRequest[]
  teacherSubjectApplications TeacherSubjectApplication[]
  announcements              Announcement[]              @relation("TeacherAnnouncements")
  teachingAssignments        Assignment[]                @relation("TeacherAssignments")
  assignmentSubmissions      AssignmentSubmission[]      @relation("StudentAssignments")
  attendances                Attendance[]                @relation("StudentAttendance")
  certificates               Certificate[]
  communityComments          CommunityComment[]
  communityLikes             CommunityLike[]
  communityPosts             CommunityPost[]
  conversationOne            Conversation[]              @relation("ParticipantOne")
  conversationTwo            Conversation[]              @relation("ParticipantTwo")
  DiscussionReply            DiscussionReply[]
  DiscussionThread           DiscussionThread[]
  enrollments                Enrollment[]
  resources                  Resource[]
  examAttempts               ExamAttempt[]
  contactMessages            ContactMessage[]
  GroupMember                GroupMember[]
  approvedLessons            Lesson[]                    @relation("LessonApprovedBy")
  createdLessons             Lesson[]                    @relation("LessonCreatedBy")
  lessonProgress             LessonProgress[]
  teachingClasses            LiveClass[]                 @relation("TeacherClasses")
  sentMessages               Message[]                   @relation("SentMessages")
  MessageReaction            MessageReaction[]
  notifications              Notification[]
  teachingSubjects           Subject[]                   @relation("TeacherSubjects")
  subscriptions              Subscription[]
  teacherProfile             TeacherProfile?

  cohortMemberships StudentCohort[]
  payments          Payment[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

model StudentProgramme {
  id        String               @id @default(uuid())
  userId    String
  programme StudentProgrammeType
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programme])
  @@index([userId])
  @@index([programme])
}

model Cohort {
  id          String               @id @default(uuid())
  name        String
  programme   StudentProgrammeType
  description String?
  startDate   DateTime
  endDate     DateTime
  fee         Int
  status      CohortStatus         @default(UPCOMING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  students      StudentCohort[]
  subscriptions Subscription[]
  payments      Payment[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  exams         Exam[]
  assignments   Assignment[]

  @@index([programme])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([programme, status])
}

model StudentCohort {
  id          String              @id @default(uuid())
  userId      String
  cohortId    String
  status      StudentCohortStatus @default(ACTIVE)
  joinedAt    DateTime            @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  subscriptions Subscription[]
  payments      Payment[]
  enrollments   Enrollment[]
  certificates  Certificate[]

  @@unique([userId, cohortId])
  @@index([userId])
  @@index([cohortId])
  @@index([status])
  @@index([userId, status])
  @@index([cohortId, status])
}

model Subject {
  id          String               @id @default(uuid())
  name        String
  description String?
  programme   StudentProgrammeType
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  teacherId   String?

  announcements       Announcement[]
  assignments         Assignment[]
  certificates        Certificate[]
  resources           Resource[]
  communityPosts      CommunityPost[]
  DiscussionThread    DiscussionThread[]
  enrollments         Enrollment[]
  subjectRequests     SubjectRequest[]
  teacherApplications TeacherSubjectApplication[]
  Exam                Exam[]
  Lesson              Lesson[]
  LiveClass           LiveClass[]
  questions           Question[]
  teacher             User?                       @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: SetNull)
  topics              Topic[]

  @@unique([name, programme])
  @@index([programme])
  @@index([teacherId])
  @@index([programme, isActive])
}

model Lesson {
  id              String       @id @default(uuid())
  title           String
  description     String?
  content         String
  videoUrl        String?
  subjectId       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  duration        Int?
  isPublished     Boolean      @default(false)
  topicId         String
  isPremium       Boolean      @default(false)
  approvedAt      DateTime?
  approvedById    String?
  createdById     String?
  rejectionReason String?
  status          LessonStatus @default(DRAFT)

  approvedBy     User?            @relation("LessonApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy      User?            @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  Subject        Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic          Topic            @relation(fields: [topicId], references: [id], onDelete: Restrict)
  lessonProgress LessonProgress[]

  @@index([subjectId])
  @@index([topicId])
  @@index([status])
  @@index([isPublished])
}

model Topic {
  id          String   @id @default(uuid())
  name        String
  description String?
  subjectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons   Lesson[]
  questions Question[]
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([subjectId])
}

model Enrollment {
  id         String               @id @default(uuid())
  userId     String
  subjectId  String
  programme  StudentProgrammeType
  type       EnrollmentType       @default(FREE)
  enrolledAt DateTime             @default(now())
  expiresAt  DateTime?

  /**
   * Cohort relationship.
   * FREE enrollments may remain without a cohort.
   * PAID enrollments should be linked to the
   * StudentCohort that granted the access.
   */
  cohortId        String?
  studentCohortId String?

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  cohort        Cohort?        @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  studentCohort StudentCohort? @relation(fields: [studentCohortId], references: [id], onDelete: Restrict)

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
  @@index([programme])
  @@index([type])
  @@index([expiresAt])
  @@index([cohortId])
  @@index([studentCohortId])
  @@index([userId, programme])
}

model SubjectRequest {
  id              String               @id @default(uuid())
  userId          String
  subjectId       String
  programme       StudentProgrammeType
  status          SubjectRequestStatus @default(PENDING)
  rejectionReason String?
  requestedAt     DateTime             @default(now())
  reviewedAt      DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId, programme])
  @@index([userId])
  @@index([subjectId])
  @@index([programme])
  @@index([status])
  @@index([userId, status])
}

model TeacherSubjectApplication {
  id              String                   @id @default(uuid())
  teacherId       String
  subjectId       String
  programme       StudentProgrammeType
  status          TeacherApplicationStatus @default(PENDING)
  rejectionReason String?
  requestedAt     DateTime                 @default(now())
  reviewedAt      DateTime?

  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, programme])
  @@index([teacherId])
  @@index([subjectId])
  @@index([programme])
  @@index([status])
}

model LessonProgress {
  id         String   @id @default(uuid())
  userId     String
  lessonId   String
  completed  Boolean  @default(false)
  progress   Int      @default(0)
  lastViewed DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Question {
  id            String     @id @default(uuid())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  subjectId     String
  createdAt     DateTime   @default(now())
  difficulty    Difficulty @default(EASY)
  examType      ExamType   @default(JAMB)
  topicId       String?
  updatedAt     DateTime   @updatedAt

  examAnswers   ExamAnswer[]
  examQuestions ExamQuestion[]
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([subjectId])
  @@index([topicId])
  @@index([examType])
  @@index([difficulty])
}

model Exam {
  id          String   @id @default(uuid())
  title       String
  subjectId   String
  cohortId    String?
  duration    Int
  totalMarks  Int
  isPublished Boolean  @default(false)
  isFinalExam Boolean  @default(false)
  createdAt   DateTime @default(now())

  certificates  Certificate[]
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  cohort        Cohort?        @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  attempts      ExamAttempt[]
  examQuestions ExamQuestion[]

  @@index([subjectId])
  @@index([cohortId])
  @@index([isPublished])
  @@index([isFinalExam])
  @@index([cohortId, isFinalExam])
}

model ExamAttempt {
  id          String    @id @default(uuid())
  examId      String
  userId      String
  score       Int       @default(0)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  completed   Boolean   @default(false)

  answers ExamAnswer[]
  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Restrict)
  user    User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([examId])
  @@index([userId])
  @@index([userId, examId])
  @@index([completed])
}

model ExamQuestion {
  id         String @id @default(uuid())
  examId     String
  questionId String

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examId, questionId])
  @@index([questionId])
}

model ExamAnswer {
  id             String   @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

enum SubscriptionBillingType {
  COHORT
  LEGACY
}

model Subscription {
  id               String                  @id @default(uuid())
  userId           String
  plan             SubscriptionPlan?
  billingType      SubscriptionBillingType @default(COHORT)
  status           SubscriptionStatus      @default(PENDING)
  startDate        DateTime?
  endDate          DateTime?
  paymentReference String?

  /**
   * Cohort-based subscription fields.
   * These remain optional so existing legacy
   * subscriptions survive migration.
   */
  cohortId        String?
  studentCohortId String?
  amount          Int?
  currency        String  @default("NGN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  studentCohort StudentCohort? @relation(fields: [studentCohortId], references: [id], onDelete: Restrict)

  payments Payment[]

  /**
   * One subscription per student/cohort.
   * This prevents duplicate active cohort subscriptions.
   */
  @@unique([studentCohortId])
  @@index([userId])
  @@index([cohortId])
  @@index([studentCohortId])
  @@index([status])
  @@index([paymentReference])
  @@index([endDate])
  @@index([userId, status])
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String
  cohortId              String?
  studentCohortId       String?
  subscriptionId        String?
  amount                Int
  currency              String        @default("NGN")
  status                PaymentStatus @default(PENDING)
  paymentReference      String?       @unique
  provider              String        @default("PAYSTACK")
  providerTransactionId String?       @unique
  paymentMethod         String?
  gatewayResponse       String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  studentCohort StudentCohort? @relation(fields: [studentCohortId], references: [id], onDelete: Restrict)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([cohortId])
  @@index([studentCohortId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
  @@index([provider])
  @@index([userId, status])
}

model LiveClass {
  id          String   @id @default(uuid())
  title       String
  description String?
  subjectId   String
  teacherId   String
  meetingLink String
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendances Attendance[]
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([subjectId])
  @@index([teacherId])
  @@index([startTime])
  @@index([isActive])
}

model Attendance {
  id          String   @id @default(uuid())
  liveClassId String
  studentId   String
  joinedAt    DateTime @default(now())

  liveClass LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student   User      @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([liveClassId, studentId])
  @@index([studentId])
}

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?
  subjectId   String
  teacherId   String
  cohortId    String?
  dueDate     DateTime
  maxScore    Int      @default(100)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher     User                   @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Restrict)
  cohort      Cohort?                @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@index([subjectId])
  @@index([teacherId])
  @@index([cohortId])
  @@index([dueDate])
  @@index([isPublished])
}

model AssignmentSubmission {
  id           String    @id @default(uuid())
  assignmentId String
  studentId    String
  content      String
  score        Int?
  feedback     String?
  submittedAt  DateTime  @default(now())
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  message     String
  teacherId   String
  subjectId   String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher User     @relation("TeacherAnnouncements", fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([teacherId])
  @@index([subjectId])
  @@index([createdAt])
  @@index([isPublished])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model Certificate {
  id              String               @id @default(uuid())
  userId          String
  studentCohortId String
  cohortId        String
  programme       StudentProgrammeType

  // Kept for compatibility with existing certificate records.
  subjectId String?
  examId    String?

  certificateNumber String @unique
  verificationCode  String @unique

  completionDate DateTime
  issuedAt       DateTime @default(now())

  status           CertificateStatus @default(ISSUED)
  revokedAt        DateTime?
  revocationReason String?

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  studentCohort StudentCohort @relation(fields: [studentCohortId], references: [id], onDelete: Restrict)
  cohort        Cohort        @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  exam    Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([studentCohortId])
  @@index([userId])
  @@index([cohortId])
  @@index([programme])
  @@index([subjectId])
  @@index([examId])
  @@index([status])
  @@index([issuedAt])
}

model CommunityPost {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  subjectId String?
  createdAt DateTime @default(now())

  comments CommunityComment[]
  likes    CommunityLike[]
  subject  Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([subjectId])
  @@index([createdAt])
}

model CommunityComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model CommunityLike {
  id     String @id @default(uuid())
  postId String
  userId String

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([postId, userId])
  @@index([userId])
}

model DiscussionThread {
  id        String   @id @default(uuid())
  title     String
  content   String
  userId    String
  subjectId String?
  createdAt DateTime @default(now())

  replies DiscussionReply[]
  subject Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  user    User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([subjectId])
  @@index([createdAt])
}

model DiscussionReply {
  id        String   @id @default(uuid())
  threadId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([threadId])
  @@index([userId])
  @@index([createdAt])
}

model StudyGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdBy   String
  createdAt   DateTime @default(now())

  members GroupMember[]

  @@index([createdAt])
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([groupId, userId])
  @@index([userId])
}

model Conversation {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  participantOneId String
  participantTwoId String

  participantOne User      @relation("ParticipantOne", fields: [participantOneId], references: [id], onDelete: Restrict)
  participantTwo User      @relation("ParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Restrict)
  messages       Message[]

  @@index([participantOneId])
  @@index([participantTwoId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())
  isRead         Boolean  @default(false)
  fileName       String?
  fileSize       Int?
  fileType       String?
  fileUrl        String?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  reactions    MessageReaction[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([conversationId, createdAt])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([messageId, userId, emoji])
  @@index([userId])
}

model TeacherProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  qualification  String?
  specialization String?
  experience     Int?
  officeHours    String?
  about          String?
  linkedin       String?
  website        String?
  twitter        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String             @id @default(uuid())
  userId    String?
  type      ContactMessageType @default(CONTACT)
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus      @default(UNREAD)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Resource {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        ResourceType
  fileUrl     String
  fileName    String
  fileSize    Int?
  publicId    String?
  subjectId   String
  teacherId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([subjectId])
  @@index([teacherId])
  @@index([type])
  @@index([createdAt])
}

enum ContactStatus {
  UNREAD
  READ
  RESOLVED
}

enum TeacherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum ExamType {
  WAEC
  JAMB
  NECO
}

enum ContactMessageType {
  CONTACT
  SUPPORT
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  SCHOOL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
